<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contacto - Beauty Glow Makeup</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body {
      background: linear-gradient(135deg, #050505 0%, #111111 35%, #c89b2b 100%);
      font-family: 'Arial', sans-serif;
      color: #f7f1d0;
    }

    .site-nav {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .site-nav a {
      text-decoration: none;
    }

    .contact-header {
      text-align: center;
      padding: 40px 20px;
      background: linear-gradient(90deg, #fffaed, #ffd6a5);
      border-radius: 15px;
      margin-bottom: 40px;
      border: 2px solid #d4af37;
    }

    .contact-header h1 {
      color: #d4af37;
      font-weight: 700;
      font-size: 2.5rem;
      margin-bottom: 10px;
    }

    .contact-header p {
      color: #8b6f47;
      font-size: 1.1rem;
    }

    .info-section {
      background: rgba(20, 20, 20, 0.95);
      border: 2px solid #d4af37;
      border-radius: 15px;
      padding: 30px;
      margin-bottom: 30px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    }

    .info-section h2 {
      color: #d4af37;
      font-weight: 700;
      margin-bottom: 25px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .info-section h2 i {
      font-size: 1.8rem;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
      padding: 15px;
      background: rgba(212, 175, 55, 0.1);
      border-radius: 10px;
      border-left: 4px solid #d4af37;
    }

    .contact-item i {
      color: #d4af37;
      font-size: 1.5rem;
      min-width: 30px;
    }

    .contact-item a {
      color: #f7d979;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .contact-item a:hover {
      color: #fffaed;
      text-decoration: underline;
    }

    .contact-item p {
      margin: 0;
      color: #f5f5f5;
    }

    .contact-form label {
      color: #f7d979;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .contact-form .form-control {
      border: 1px solid #d4af37;
      border-radius: 8px;
      padding: 12px;
    }

    .social-links {
      display: flex;
      gap: 20px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    .social-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 55px;
      height: 55px;
      border-radius: 50%;
      background: linear-gradient(135deg, #d4af37, #c08d1a);
      color: #111;
      text-decoration: none;
      font-size: 1.5rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
    }

    .social-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 16px rgba(212, 175, 55, 0.5);
    }

    .sede {
      background: rgba(30, 30, 30, 0.8);
      border: 1px solid #d4af37;
      border-radius: 12px;
      padding: 25px;
      margin-bottom: 25px;
    }

    .sede h3 {
      color: #d4af37;
      margin-bottom: 15px;
      font-weight: 700;
    }

    .sede-info {
      color: #f5f5f5;
      line-height: 1.8;
    }

    .sede-info strong {
      color: #f7d979;
    }

    .about-section {
      background: rgba(212, 175, 55, 0.15);
      border: 2px solid #d4af37;
      border-radius: 15px;
      padding: 30px;
      color: #f5f5f5;
      line-height: 1.8;
    }

    .about-section h2 {
      color: #d4af37;
      font-weight: 700;
      margin-bottom: 15px;
    }

    .image-gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .gallery-img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 12px;
      border: 2px solid #d4af37;
      transition: transform 0.3s ease;
    }

    .gallery-img:hover {
      transform: scale(1.05);
    }

    .btn-contact {
      background: linear-gradient(135deg, #d4af37, #c08d1a);
      color: #111;
      border: none;
      padding: 12px 30px;
      border-radius: 8px;
      font-weight: 700;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .btn-contact:hover {
      filter: brightness(1.1);
      transform: translateY(-2px);
    }

    @media (max-width: 768px) {
      .contact-header h1 {
        font-size: 1.8rem;
      }

      .social-links {
        justify-content: center;
      }

      .image-gallery {
        grid-template-columns: 1fr;
      }
    }

    /* Estilos para Instagram Modal */
    .instagram-profile {
      background: linear-gradient(135deg, #feda75 0%, #fa7e1e 50%, #d92e7f 100%);
      padding: 20px;
      border-radius: 15px;
      text-align: center;
      margin-bottom: 25px;
      border: 3px solid #d4af37;
    }

    .instagram-profile h3 {
      color: #fff;
      font-weight: 700;
      font-size: 1.5rem;
      margin: 0;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    }

    .instagram-profile p {
      color: #fff;
      margin: 5px 0 0 0;
      font-weight: 600;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .stories-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }

    .story-item {
      position: relative;
      width: 120px;
      height: 180px;
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      border: 3px solid #d4af37;
      transition: transform 0.3s ease;
    }

    .story-item:hover {
      transform: scale(1.05);
    }

    .story-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .story-label {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.7);
      color: #fff;
      padding: 8px;
      font-size: 0.85rem;
      font-weight: 700;
      text-align: center;
    }
  </style>
</head>
